<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AgendaText">
        <item name="android:textColor">?attr/agenda_text</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">sans</item>
    </style>

    <style name="AgendaTitle" parent="AgendaText">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AgendaHeading" parent="AgendaText">
        <item name="android:textSize">@dimen/text_heading</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AgendaSecondaryText" parent="AgendaText">
        <item name="android:textColor">?attr/agenda_text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="AgendaCard">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">@dimen/card_padding</item>
        <item name="android:elevation">2dp</item>
    </style>

    <style name="AgendaPrimaryButton">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">?attr/agenda_button_text</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <style name="AgendaInput">
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:textColor">?attr/agenda_text</item>
        <item name="android:textColorHint">?attr/agenda_text_secondary</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:padding">14dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

</resources>
