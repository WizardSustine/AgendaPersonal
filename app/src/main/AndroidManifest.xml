<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <application
        android:name=".AgendaApplication"
        android:usesCleartextTraffic="false"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AgendaPersonal"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.TareasActivity"
            android:exported="false" />
        <activity
            android:name=".ui.AgendaActivity"
            android:exported="false" />
        <activity android:name=".ui.EventosActivity" android:exported="false"/>
        <activity android:name=".ui.EstudiosActivity" android:exported="false"/>
        <activity android:name=".ui.SocialesActivity" android:exported="false"/>
        <activity android:name=".ui.SaludActivity" android:exported="false"/>
        <activity android:name=".ui.TrabajoActivity" android:exported="false"/>
        <activity android:name=".ui.FreelanceActivity" android:exported="false"/>
        <activity android:name=".ui.EconomiaActivity" android:exported="false"/>
        <activity android:name=".ui.EjercicioActivity" android:exported="false"/>
        <activity android:name=".ui.EstadoEmocionalActivity" android:exported="false"/>
        <activity android:name=".ui.InvestigacionesActivity" android:exported="false"/>
        <activity android:name=".ui.PersonasActivity" android:exported="false"/>
        <activity android:name=".ui.FrasesActivity" android:exported="false"/>
        <activity android:name=".ui.AjustesActivity" android:exported="false"/>
        <activity android:name=".ui.AyudaActivity" android:exported="false"/>
        <activity android:name=".ui.MovimientosActivity" android:exported="false"/>
        <activity android:name=".ui.CatalogosActivity" android:exported="false"/>
        <activity android:name=".ui.ConexionActivity" android:exported="false"/>
        <service android:name=".sync.TrabajoSync" android:permission="android.permission.BIND_JOB_SERVICE" android:exported="true"/>
        <activity android:name=".ui.NotificacionesActivity" android:exported="false"/>
        <receiver android:name=".avisos.ReceptorAvisos" android:exported="false"><intent-filter>
            <action android:name="android.intent.action.BOOT_COMPLETED"/><action android:name="android.intent.action.TIME_SET"/><action android:name="android.intent.action.TIMEZONE_CHANGED"/><action android:name="android.intent.action.MY_PACKAGE_REPLACED"/><action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED"/>
        </intent-filter></receiver>
        <service android:name=".avisos.VentanaAvisos" android:exported="false" android:foregroundServiceType="specialUse"><property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="User-enabled floating list of today's critical personal agenda activities"/></service>
        <activity android:name=".ui.RespaldoActivity" android:exported="false" android:configChanges="orientation|screenSize"/>
    </application>

</manifest>